# ─────────────────────────────────────────────────────────────────────────────
#  ALFA – Traduttore vocale hands-free · configurazione backend
#  Copia questo file in `.env` e compila solo ciò che ti serve.
#  Le chiavi restano SOLO sul server: il browser non le vede mai.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3000
HOST=0.0.0.0

# Token opzionale: se impostato, l'app deve inviarlo (Impostazioni → Token di accesso).
# Utile se pubblichi il server su Internet e non vuoi che altri consumino le tue API.
APP_ACCESS_TOKEN=

# Limite richieste per IP al minuto
RATE_LIMIT_PER_MIN=240

# ── TRADUZIONE ───────────────────────────────────────────────────────────────
# Provider: openai | anthropic | deepl | mymemory | mock
#   openai     → qualsiasi API compatibile OpenAI (OpenAI, Groq, OpenRouter, Ollama, LM Studio…)
#   anthropic  → Claude (streaming nativo)
#   deepl      → DeepL API (non streaming, ma molto veloce)
#   mymemory   → gratuito senza chiave, qualità base (ottimo per provare subito)
#   mock       → nessuna rete, restituisce il testo marcato (sviluppo/test)
TRANSLATE_PROVIDER=mymemory

# Provider "openai" (compatibile OpenAI)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Esempio FreeLLMAPI (router gratuito compatibile OpenAI, es. sul tuo server):
# TRANSLATE_PROVIDER=openai
# LLM_BASE_URL=https://ai.tuodominio.it/v1
# LLM_API_KEY=la-tua-chiave-freellmapi
# LLM_MODEL=gemini-3.1-flash-lite      # veloce; "auto" sceglie il modello migliore disponibile
# Esempio Groq (latenza molto bassa):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant

# Provider "anthropic"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Provider "deepl" (per l'account Pro usa https://api.deepl.com)
DEEPL_API_KEY=
DEEPL_BASE_URL=https://api-free.deepl.com

# Email opzionale per MyMemory (alza il limite giornaliero gratuito)
MYMEMORY_EMAIL=

# ── SPEECH-TO-TEXT CLOUD (Whisper) – consigliato su iPhone ───────────────────
# Qualsiasi endpoint compatibile con /audio/transcriptions di OpenAI.
# Lascia vuota la chiave per disattivare la modalità cloud.
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
# Esempio Groq (gratuito con limiti giornalieri, molto rapido). Consigliato anche
# su Android: a differenza del riconoscimento del browser non emette alcun beep.
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=gsk_...
# STT_MODEL=whisper-large-v3-turbo

# ── TEXT-TO-SPEECH CLOUD (voci neurali) – opzionale ──────────────────────────
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Se impostata, OPENAI_API_KEY fa da valore predefinito per LLM/STT/TTS vuoti.
OPENAI_API_KEY=
